#!/bin/bash
#SBATCH -J gru05      	# Job name
#SBATCH -o ./training_outputs/gru_05_%j.out              	# output file (%j expands to jobID)
#SBATCH -e ./training_outputs/gru_05_%j.err              	# error log file (%j expands to jobID)
#SBATCH --mail-type=ALL                  	# Request status by email
#SBATCH --mail-user=mb2554@cornell.edu.   	# Email address to send results to.
#SBATCH -N 1                             	# Total number of nodes requested
#SBATCH -n 8                             	# Total number of cores requested
#SBATCH --get-user-env                   	# retrieve the users login environment
#SBATCH --mem=64gb                   	# server memory requested (per node)
#SBATCH -t 70:00:00                       	# Time limit (hh:mm:ss)
#SBATCH --gres=gpu:1              	# Type/number of GPUs needed


#export your required environment variables below
#################################################

export WANDB_API_KEY=${WANDB_API_KEY:?set this in your environment, do not commit it}


python3 gru_05.py